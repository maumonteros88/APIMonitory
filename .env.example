# Copy this file to .env and fill in real values. .env is gitignored.

# Password for the Postgres container used by docker-compose (and by
# `make dev-db` for local, non-Docker API development).
# Generate one with: openssl rand -hex 32
POSTGRES_PASSWORD=

# Bearer token required by every /api/* route except /healthz. The frontend
# asks for this token once and stores it in localStorage.
# Generate one with: openssl rand -hex 32
API_TOKEN=

# Optional overrides (defaults shown). Uncomment to change.
#POSTGRES_USER=apimonitory
#POSTGRES_DB=apimonitory
# Host port for the Postgres container. Defaults to 5433 to avoid clashing
# with a Postgres instance already running locally on 5432.
#POSTGRES_PORT=5433
# Timezone used to decide what "day" a check belongs to (daily_stats rows,
# uptime history). Matters wherever the app actually runs, since it's never
# derived from the server's own local time.
#APP_TIMEZONE=America/Argentina/Buenos_Aires
