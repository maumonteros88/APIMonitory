# Copy to deploy/deploy.env (git-ignored) and adjust. Read by deploy.sh.
# Values with no spaces; "~" is expanded in DEPLOY_SIGNING_KEY.

# Public base URL; deploy.sh polls <url>/healthz until it reports the
# commit it just released.
DEPLOY_PUBLIC_URL=https://203-0-113-10.sslip.io

# Private key that signs api.exe. Its public half (the .pub next to it) is
# what the server trusts (setup-autoupdate.ps1 -PublicKey). If the key is
# loaded in ssh-agent, signing uses the agent and never prompts.
DEPLOY_SIGNING_KEY=~/.ssh/apimonitory_deploy

# Seconds to wait for the server to pick the release up (optional,
# default 300; the server checks about every 2 minutes).
DEPLOY_TIMEOUT=300
