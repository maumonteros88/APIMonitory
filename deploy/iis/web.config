<?xml version="1.0" encoding="utf-8"?>
<!--
  APIMonitory on IIS, through the ASP.NET Core Module V2 (ANCM).

  The hosting model MUST be OutOfProcess. InProcess only hosts .NET
  apps: pointing it at a Go binary (or copying the web.config of
  another site on this server, which is InProcess) fails with
  HTTP 500.30. In OutOfProcess mode ANCM launches api.exe, picks a
  free port, passes it in ASPNETCORE_PORT and reverse-proxies to it.

  No environmentVariables here on purpose: DATABASE_URL, API_TOKEN
  and the rest live on the app pool (see setup-iis.ps1), so secrets
  never sit in the site folder.

  Reference:
  https://learn.microsoft.com/en-us/aspnet/core/host-and-deploy/iis/web-config
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*"
             modules="AspNetCoreModuleV2"
             resourceType="Unspecified" />
      </handlers>
      <!--
        requestTimeout is raised from the 2-minute default so the
        long-lived SSE stream isn't cut. shutdownTimeLimit (seconds)
        gives api.exe time for its own graceful shutdown, which
        waits up to 10 s.
      -->
      <aspNetCore processPath=".\api.exe"
                  hostingModel="OutOfProcess"
                  requestTimeout="12:00:00"
                  shutdownTimeLimit="20"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  forwardWindowsAuthToken="false" />
      <!--
        Dynamic compression buffers output and would hold back SSE
        events. It is disabled for the whole site: a separate
        <location path="api/events"> did not inherit the ANCM handler
        above, so IIS answered that path with its own 404.
      -->
      <urlCompression doDynamicCompression="false" />
    </system.webServer>
  </location>
</configuration>
